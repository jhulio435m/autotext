API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOW_ALL_CORS=false
REQUEST_BODY_LIMIT_MB=25
API_AUTH_ENABLED=true
INTEGRATION_PROFILE_WRITE_ENABLED=false

BRIDGE_ONLY=true
ENABLE_APP_ENDPOINTS=false
PLANE_PROJECT_SCHEMA=public
PLANE_PROJECT_TABLES=project_project,projects
PLANE_PROJECTS_LIMIT=200
PLANE_BASE_URL=https://plane.urriburuleon.com
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
PLANE_API_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m
AUTH_BCRYPT_COST=12
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_IP_RATE_LIMIT_MAX=30
AUTH_LOGIN_EMAIL_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=600000
AUTH_FAILED_LOGIN_MAX=5
AUTH_LOCKOUT_MS=900000
AUTH_SESSION_COOKIE_ENABLED=false
AUTH_SESSION_COOKIE_SECURE=false

# Fuente externa de Plane: solo lectura
# Si usas tunel SSH, normalmente queda en localhost:5432
PLANE_DB_HOST=127.0.0.1
PLANE_DB_PORT=5432
PLANE_DB_USER=plane
PLANE_DB_PASSWORD=plane
PLANE_DB_NAME=plane
PLANE_DB_SSL=false

# Persistencia propia de la app (auth/workspace)
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=autotext
APP_DB_SSL=false

# Compatibilidad heredada con configuraciones antiguas
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=autotext
DB_SSL=false

# Seed opcional para crear usuario de login automaticamente con npm run db:init
SEED_ADMIN_EMAIL=ingeniero@empresa.com
SEED_ADMIN_PASSWORD=cambia-esta-contrasena-larga-2026
SEED_ADMIN_NAME=Ing. Carlos Rivera
SEED_ADMIN_ROLE=Senior

# ── Asistente IA ──────────────────────────────────────────────────────────────
AI_REQUIRE_AUTH=true
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=12
AI_MAX_PROMPT_CHARS=4000
AI_MAX_CONTEXT_ENTRIES=30
AI_MAX_CONTEXT_VALUE_CHARS=400
AI_MAX_BLOCKS_PER_REQUEST=20
# Obtén tu API Key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo a usar. Opciones sugeridas: gpt-4o-mini (económico) | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
