{
  "name": "autotext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:web:public": "vite --host 0.0.0.0 --port 5174",
    "dev:api": "node server/index.js",
    "dev:api:public": "API_HOST=0.0.0.0 node server/index.js",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:full:public": "concurrently \"npm run dev:api:public\" \"npm run dev:web:public\"",
    "public:start": "bash scripts/start-public.sh",
    "public:stop": "bash scripts/stop-public.sh",
    "public:status": "bash scripts/status-public.sh",
    "profile:list": "ls env/profiles/*.web.env | sed 's#^.*/##; s#.web.env$##' | sort",
    "profile:local": "bash scripts/use-profile.sh local",
    "profile:plane-db": "bash scripts/use-profile.sh plane-db",
    "profile:plane-api": "bash scripts/use-profile.sh plane-api",
    "db:init": "node server/scripts/init-db.js",
    "test": "node --test",
    "test:unit": "node --test test/**/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fortune-sheet/react": "^1.0.4",
    "@tiptap/extension-mention": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.24.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.33",
    "lucide-react": "^1.0.1",
    "nanoid": "^5.1.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "puppeteer": "^24.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "sanitize-html": "^2.17.4",
    "tippy.js": "^6.3.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
