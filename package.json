{
  "name": "autotext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "erp:init": "docker compose --env-file frappe/.env -f frappe/compose.yml up configurator create-site",
    "erp:up": "docker compose --env-file frappe/.env -f frappe/compose.yml up -d",
    "erp:down": "docker compose --env-file frappe/.env -f frappe/compose.yml down",
    "erp:logs": "docker compose --env-file frappe/.env -f frappe/compose.yml logs -f frontend backend websocket scheduler queue-short queue-long",
    "erp:ps": "docker compose --env-file frappe/.env -f frappe/compose.yml ps",
    "db:init": "node server/scripts/init-db.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.33",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
